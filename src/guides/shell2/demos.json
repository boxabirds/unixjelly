{
 "whoami": [
  "whoami",
  "hostname",
  "ls /home"
 ],
 "redirect": [
  "echo I like cheese > note.txt",
  "cat note.txt",
  "echo and jelly >> note.txt",
  "cat note.txt"
 ],
 "nano": [
  "nano note.txt",
  "@type:I like pizza\\nand jelly",
  "@key:Control+x",
  "@key:y",
  "cat note.txt"
 ],
 "which": [
  "which ls",
  "ls /bin",
  "which cd"
 ],
 "dotslash": [
  "nano hello",
  "@type:hello",
  "@key:Control+o",
  "@key:Control+x",
  "chmod u+x hello",
  "./hello",
  "chmod u-x hello",
  "nano hello",
  "@type:echo Hello from my program!",
  "@key:Control+o",
  "@key:Control+x",
  "cat hello",
  "hello",
  "./hello"
 ],
 "lsl": [
  "ls -l",
  "ls -l /bin",
  "ls -l /home"
 ],
 "chmod": [
  "chmod u+x hello",
  "ls -l",
  "./hello"
 ],
 "path": [
  "echo $PATH",
  "mkdir ~/bin",
  "mv hello ~/bin/hi",
  "cd /",
  "hi",
  "cd"
 ],
 "groups": [
  "id",
  "id sib",
  "mkdir comics",
  "chgrp family comics",
  "chmod g+w comics"
 ],
 "su": [
  "su sib",
  "whoami",
  "cat diary.txt",
  "touch comics/kapow.txt",
  "exit"
 ],
 "sudo": [
  "cat /tmp/chest.txt",
  "sudo whoami",
  "sudo cat /tmp/chest.txt"
 ],
 "grep": [
  "grep cookie diary.txt",
  "grep gerald story.txt",
  "grep -i gerald story.txt"
 ],
 "pipe": [
  "grep cookie kitchen.log",
  "grep cookie kitchen.log | grep sib",
  "grep cookie kitchen.log | grep sib | wc -l"
 ],
 "binary": [
  "chmod 600 note.txt",
  "chmod 644 note.txt",
  "chmod 900 note.txt"
 ],
 "quest": [
  "mkdir clubhouse",
  "chgrp family clubhouse",
  "chmod o-rx clubhouse",
  "echo \"echo knock knock knock\" > clubhouse/knock",
  "chmod u+x clubhouse/knock",
  "su sib",
  "./clubhouse/knock",
  "exit"
 ]
}
